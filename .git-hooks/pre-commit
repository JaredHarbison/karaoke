#!/usr/bin/env bash
set -euo pipefail

echo "Running fast staged-change checks..."

export XDG_CACHE_HOME="${TMPDIR:-/tmp}/karaoke-rubocop-cache"
mkdir -p "$XDG_CACHE_HOME"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "$staged_files" ]]; then
  echo "No staged files; nothing to check."
  exit 0
fi

behavior_files="$(printf '%s\n' "$staged_files" | grep -E '^(app/|config/routes\.rb$|db/migrate/|spec/|Gemfile$|Gemfile\.lock$)' || true)"
if [[ -n "$behavior_files" ]]; then
    documentation_files="$(printf '%s\n' "$staged_files" | grep -E '^docs/ROADMAP\.md$|^docs/qa/' || true)"
    if [[ -z "$documentation_files" ]]; then
      echo "FAILED: behavior changes must review and update docs/ROADMAP.md or docs/qa/"
    echo "Relevant staged files:"
    printf '%s\n' "$behavior_files"
    echo "If documentation is genuinely not relevant, split the change or document that decision in the commit review."
    exit 1
  fi
fi

fail_if_found() {
  local label="$1"
  local pattern="$2"
  if git diff --cached --no-ext-diff --unified=0 -- . ':!Gemfile.lock' | grep -Ei "$pattern" >/dev/null; then
    echo "FAILED: $label"
    git diff --cached --no-ext-diff --unified=0 -- . ':!Gemfile.lock' | grep -Ei "$pattern" || true
    exit 1
  fi
}

fail_if_found "debug code detected" '^\+[[:space:]]*(binding\.pry|byebug|debugger)([^[:alnum:]_]|$)'
fail_if_found "obvious secret material detected" '(AKIA[0-9A-Z]{16}|-----BEGIN (RSA|EC|OPENSSH|PRIVATE) KEY-----|(api[_-]?key|client[_-]?secret|access[_-]?token)[[:space:]]*[:=][[:space:]]*[[:alnum:]_./+=-]{12,})'

ruby_files="$(printf '%s\n' "$staged_files" | grep -E '(\.rb$|^config/routes\.rb$)' || true)"
if [[ -n "$ruby_files" ]]; then
  # CI lints the full app. Lint every staged Ruby change here too, so ordinary
  # controller/model edits cannot pass locally and then fail the deployment.
  bundle exec rubocop --cache false --force-exclusion $ruby_files
  while IFS= read -r ruby_file; do
    [[ -z "$ruby_file" ]] || bundle exec ruby -c "$ruby_file"
  done <<< "$ruby_files"
fi

erb_files="$(printf '%s\n' "$staged_files" | grep -E '\.erb$' || true)"
if [[ -n "$erb_files" ]]; then
  bundle exec erb_lint $erb_files
fi

if printf '%s\n' "$staged_files" | grep -Eq '^(app/.*\.rb|config/routes\.rb|spec/.*_spec\.rb)$'; then
  bin/rspec --tag critical
fi

echo "Fast staged-change checks passed. CI remains authoritative for full checks."
