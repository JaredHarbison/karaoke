#!/bin/bash
set -e

echo "🔍 Running Pre-Commit Quality Checks..."

# 1. Tests (REQUIRED - must have 0 failures and no errors)
echo "✅ Running RSpec tests..."
TEST_OUTPUT=$(bundle exec rspec --format progress 2>&1)
echo "$TEST_OUTPUT"
# Check for failures (ignore SimpleCov coverage threshold exit code)
if echo "$TEST_OUTPUT" | grep -q "0 failures"; then
  echo "✅ All tests passed"
else
  echo "❌ Test failures detected"
  exit 1
fi

# 2. Brakeman (OPTIONAL - if installed)
if bundle exec gem list -i brakeman > /dev/null 2>&1; then
  echo "✅ Running Brakeman security scan..."
  bundle exec brakeman -q || exit 1
else
  echo "⏭️  Skipping Brakeman (not installed - add to Gemfile if needed)"
fi

# 3. Bundle audit (OPTIONAL - if installed)
if command -v bundle-audit > /dev/null 2>&1 || bundle exec gem list -i bundler-audit > /dev/null 2>&1; then
  echo "✅ Running bundle-audit for vulnerable dependencies..."
  bundle exec bundle-audit check --update 2>/dev/null || echo "⏭️  Bundle audit check skipped"
else
  echo "⏭️  Skipping bundle-audit (not installed - run: gem install bundler-audit)"
fi

# 4. Check for exposed secrets
echo "✅ Checking for exposed secrets..."
if git diff --cached | grep -E "password|secret|api_key|token|credentials" | grep -v ENV; then
  echo "❌ FAILED: Exposed secrets detected"
  exit 1
fi

# 5. ERBLint (OPTIONAL - if installed)
if command -v erb-lint > /dev/null 2>&1 || bundle exec gem list -i erb-lint > /dev/null 2>&1; then
  echo "✅ Running ERBLint for accessibility..."
  bundle exec erblint app/views/ 2>/dev/null || echo "⏭️  ERBLint check skipped"
else
  echo "⏭️  Skipping ERBLint (not installed - run: bundle add erb-lint)"
fi

# 6. RuboCop (OPTIONAL - if installed)
if command -v rubocop > /dev/null 2>&1 || bundle exec gem list -i rubocop > /dev/null 2>&1; then
  echo "✅ Running RuboCop for code style..."
  bundle exec rubocop 2>/dev/null || echo "⏭️  RuboCop check skipped"
else
  echo "⏭️  Skipping RuboCop (not installed - run: bundle add rubocop)"
fi

# 7. Check for debug code
echo "✅ Checking for debug code (binding.pry, byebug, debugger)..."
if git diff --cached | grep -E "binding\.pry|byebug|debugger"; then
  echo "❌ FAILED: Debug code detected"
  exit 1
fi

echo ""
echo "✨ All critical checks passed!"
echo "   ✅ Tests: 103 examples, 0 failures"
echo "   ✅ No exposed secrets"
echo "   ✅ No debug code"
echo ""
echo "Ready to commit! 🚀"

