<main class="management-page" aria-labelledby="new-theme-heading">
  <%= render 'shared/management_page_header', heading_id: 'new-theme-heading', title: 'Create Theme', back_label: 'Back to Themes', back_path: venue_themes_path(Current.venue.slug) %>
  <section class="management-card management-form-card">
    <%= render "form", form_url: venue_themes_path(Current.venue.slug), form_method: :post %>
  </section>
</main>
