<%= form_with model: @theme, url: form_url, method: form_method, local: true do |form| %>
  <% if @theme.errors.any? %>
    <div role="alert">
      <h2><%= pluralize(@theme.errors.count, "error") %> prevented saving:</h2>
      <ul>
        <% @theme.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, "Theme name" %>
    <%= form.text_field :name, required: true %>
  </div>
  <div>
    <%= form.label :description, "Description" %>
    <%= form.text_area :description %>
  </div>
  <div>
    <%= form.label :active, "Available for event hosts" %>
    <%= form.check_box :active %>
  </div>
  <fieldset>
    <legend>Song admission rules</legend>
    <p>Enter comma-separated words. Metadata must include every required word and none of the blocked words.</p>
    <div>
      <%= form.label :required_keywords_text, "Required keywords" %>
      <%= form.text_field :required_keywords_text, placeholder: "disco, classics" %>
    </div>
    <div>
      <%= form.label :blocked_keywords_text, "Blocked keywords" %>
      <%= form.text_field :blocked_keywords_text, placeholder: "explicit, live" %>
    </div>
  </fieldset>
  <p>When metadata is unavailable, the song goes to host review.</p>
  <%= form.submit %>
<% end %>
