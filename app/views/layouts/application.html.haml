!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Karaoke QUEUE
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    = favicon_link_tag asset_path('favicon.svg')
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body{ class: ('auth-screen' if controller_path.start_with?('devise/')) }
    %header.app-header
      .app-header__bar
        = render 'shared/brand_lockup'
        - if content_for?(:app_header_actions)
          .app-header__actions
            = yield :app_header_actions
      - if notice.present?
        %p.notice{ role: 'status', data: { controller: 'flash' } }= notice
      - if alert.present?
        %p.alert{ role: 'alert' }= alert
    = yield
