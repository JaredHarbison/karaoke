!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Karaoke QUEUE
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    = favicon_link_tag asset_path('favicon.svg')
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
  - auth_surface = controller_path.match?(/\A(devise|users\/sessions)\z/) || (controller_path == 'users/registrations' && action_name != 'edit')
  - presentation_surface = controller_path == 'songs' && action_name == 'presentation'
  %body{ class: [auth_surface ? 'auth-screen' : nil, presentation_surface ? 'presentation-screen' : nil] }
    %a.skip-link{ href: '#main-content' } Skip to main content
    .app-shell
      = render 'shared/application_shell'
      .app-shell__body
        .app-shell__content#main-content
          = yield
