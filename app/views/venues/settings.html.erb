<div class="container mt-5">
  <div class="row">
    <div class="col-md-8">
      <h1><%= @venue.name %> Settings</h1>
      
      <div class="card mb-4">
        <div class="card-header">
          <h5>Venue Information</h5>
        </div>
        <div class="card-body">
          <%= form_with(model: @venue, local: true, url: venue_settings_path(@venue.slug), method: :patch) do %>
            <div class="mb-3">
              <label for="venue_name" class="form-label">Venue Name</label>
              <input type="text" class="form-control" name="venue[name]" id="venue_name" value="<%= @venue.name %>" required>
            </div>
            
            <div class="mb-3 form-check">
              <input type="checkbox" class="form-check-input" name="venue[public]" id="venue_public" <%= 'checked' if @venue.public %>>
              <label class="form-check-label" for="venue_public">Public Venue</label>
            </div>
            
            <button type="submit" class="btn btn-primary">Save Settings</button>
          <% end %>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h5>Administrators</h5>
        </div>
        <div class="card-body">
          <% if @admins.any? %>
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Email</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @admins.each do |admin| %>
                  <tr>
                    <td><%= admin.email %></td>
                    <td>
                      <%= button_to "Remove", venue_admin_path(@venue.slug, admin.id), method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Are you sure?" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted">No admins yet.</p>
          <% end %>

          <hr>

          <h6>Add Administrator</h6>
          <%= form_with(local: true, url: venue_admins_path(@venue.slug), method: :post) do %>
            <div class="input-group">
              <input type="email" name="email" class="form-control" placeholder="Enter admin email" required>
              <button class="btn btn-primary" type="submit">Add Admin</button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
