<div class="venue-settings">
  <header class="settings-header">
    <div>
      <%= link_to "Back to Events", venue_events_path(@venue.slug), class: "settings-back-link" %>
      <h1>Manage <%= @venue.name %></h1>
      <p class="settings-header__copy">Keep your venue details current and decide who can run the queue with you.</p>
    </div>
    <div class="settings-header__badge">
      <span class="settings-header__badge-dot"></span>
      Owner Access
    </div>
  </header>

  <main class="settings-main">
    <section class="settings-stats" aria-label="Venue summary">
      <div class="settings-stat">
        <span class="settings-stat__label">Visibility</span>
        <strong><%= @venue.public? ? "Public" : "Private" %></strong>
        <span><%= @venue.public? ? "Discoverable by performers" : "Invite or share the venue link" %></span>
      </div>
      <div class="settings-stat">
        <span class="settings-stat__label">Hosts</span>
        <strong><%= @hosts.size %></strong>
        <span><%= @hosts.size == 1 ? "person" : "people" %> can manage the queue</span>
      </div>
      <div class="settings-stat settings-stat--highlight">
        <span class="settings-stat__label">Venue Link</span>
        <strong>/<%= @venue.slug %></strong>
        <span>Share this with performers</span>
      </div>
    </section>

    <div class="settings-grid">
      <section class="settings-card settings-card--details">
        <div class="settings-card__heading">
          <div>
            <h2>Venue Details</h2>
          </div>
          <span class="settings-card__icon">✦</span>
        </div>
        <p class="settings-card__intro">This is what performers see when they discover or join your venue.</p>

        <%= form_with(model: @venue, local: true, url: venue_settings_path(@venue.slug), method: :patch, class: "settings-form") do |form| %>
          <div class="settings-field">
            <%= form.label :name, "Venue Name" %>
            <%= form.text_field :name, required: true, autocomplete: "organization" %>
          </div>

          <div class="settings-field">
            <%= form.label :location, "Location", class: "settings-field__label-with-hint" do %>
              <span>Location</span>
              <span>Optional</span>
            <% end %>
            <%= form.text_field :location, placeholder: "e.g. 523 Franklin St", autocomplete: "street-address" %>
          </div>

          <div class="settings-field">
            <%= form.label :time_zone, "Venue Time Zone" %>
            <%= form.collection_select :time_zone, @time_zones, :name, :name %>
            <small>Event times and access-code expiry use this time zone.</small>
          </div>

          <label class="visibility-toggle" for="venue_public">
            <span class="visibility-toggle__switch">
              <%= form.check_box :public, id: "venue_public" %>
              <span class="visibility-toggle__track"></span>
            </span>
            <span>
              <strong>Public Venue</strong>
              <small>Allow people to find this venue on the Discover page.</small>
            </span>
          </label>

          <label class="visibility-toggle" for="venue_explicit_lyrics_allowed">
            <span class="visibility-toggle__switch">
              <%= form.check_box :explicit_lyrics_allowed, id: "venue_explicit_lyrics_allowed" %>
              <span class="visibility-toggle__track"></span>
            </span>
            <span>
              <strong>Allow Explicit Lyrics</strong>
              <small>Permit event queue selections identified as explicit by provider metadata.</small>
            </span>
          </label>

          <div class="settings-form__actions">
            <%= form.submit "Save Venue Details", class: "settings-button settings-button--primary" %>
          </div>
        <% end %>
      </section>

      <section class="settings-card settings-card--hosts">
        <div class="settings-card__heading">
          <div>
            <h2>Your Hosts</h2>
          </div>
          <span class="settings-card__icon">♢</span>
        </div>
        <p class="settings-card__intro">Hosts can play, skip, and finish songs. They cannot change venue settings.</p>

        <div class="host-list">
          <% if @hosts.any? %>
            <% @hosts.each do |host| %>
              <div class="host-row">
                <span class="host-avatar"><%= host.last_name_initial %></span>
                <span class="host-row__identity">
                  <strong><%= host.management_name %></strong>
                  <small>Queue Host</small>
                </span>
                <%= button_to "Remove", venue_admin_path(@venue.slug, host.id), method: :delete, class: "settings-button settings-button--quiet-danger", data: { turbo_confirm: "Remove #{host.management_name} as a host?" } %>
              </div>
            <% end %>
          <% else %>
            <div class="host-empty">
              <span class="host-empty__icon">＋</span>
              <strong>You’re the only person managing this venue.</strong>
              <span>Add a host below when you’re ready to share queue duties.</span>
            </div>
          <% end %>
        </div>

        <div class="add-host">
          <h3>Add a Host</h3>
          <p>Enter the email address of an existing Karaoke user.</p>
          <%= form_with(local: true, url: venue_admins_path(@venue.slug), method: :post, class: "add-host__form") do %>
            <%= email_field_tag :email, nil, placeholder: "host@example.com", required: true, autocomplete: "email" %>
            <%= submit_tag "Add Host", class: "settings-button settings-button--secondary" %>
          <% end %>
        </div>
      </section>
    </div>

    <section class="settings-owner-note">
      <span class="settings-owner-note__icon">✓</span>
      <div>
        <strong>You’re in control of this venue</strong>
        <p>Only you can access these settings or add and remove hosts.</p>
      </div>
    </section>
  </main>
</div>
