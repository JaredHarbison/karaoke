<div class="container">
  <div class="row">
    <div class="col-md-12">
      <h1>Discover Venues</h1>

      <form method="get" class="mb-4">
        <div class="input-group">
          <input type="text" name="search" class="form-control" placeholder="Search venues..." autocomplete="off" value="<%= params[:search] %>">
          <button type="submit" class="btn btn--primary">Search</button>
        </div>
      </form>

      <% if @venues.any? %>
        <div class="row">
          <% @venues.each do |venue| %>
            <div class="col-md-4 mb-4">
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title"><%= venue.name %></h5>
                  <p class="card-text text-muted"><%= venue.slug %></p>
                  <%= button_to "Join Venue", join_venue_path(slug: venue.slug), method: :post, class: "btn btn--primary" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted">No venues found.</p>
      <% end %>
    </div>
  </div>
</div>
