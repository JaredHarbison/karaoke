<main class="management-page" aria-labelledby="edit-event-heading">
  <%= render 'shared/management_page_header', heading_id: 'edit-event-heading', title: 'Edit Event', back_label: 'Back to Event', back_path: venue_event_path(Current.venue.slug, @event) %>
  <section class="management-card management-form-card">
    <%= render "form", form_url: venue_event_path(Current.venue.slug, @event), form_method: :patch %>
  </section>
</main>
