<%= form_with model: @event, url: form_url, method: form_method, local: true, class: 'backoffice-form', data: (@event.persisted? ? {} : { controller: 'event-recurrence' }) do |form| %>
  <% if @event.errors.any? %>
    <div class="backoffice-form__errors" role="alert">
      <h2><%= pluralize(@event.errors.count, "error") %> prevented saving:</h2>
      <ul>
        <% @event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="backoffice-form__field">
    <%= form.label :name, "Event name" %>
    <%= form.text_field :name, required: true %>
  </div>
  <div class="backoffice-form__field">
    <%= form.label :starts_at, "Starts" %>
    <%= form.datetime_local_field :starts_at, value: datetime_local_value(@event.starts_at), required: true %>
  </div>
  <div class="backoffice-form__field">
    <%= form.label :ends_at, "Ends" %>
    <%= form.datetime_local_field :ends_at, value: datetime_local_value(@event.ends_at) %>
  </div>
  <% if !@event.persisted? %>
    <fieldset class="backoffice-form__fieldset">
      <legend>Recurrence</legend>
      <label class="recurrence-toggle" for="recurrence_enabled">
        <%= check_box_tag 'recurrence[enabled]', '1', @recurrence[:enabled], id: 'recurrence_enabled', data: { event_recurrence_target: 'toggle', action: 'event-recurrence#update' } %>
        <span class="recurrence-toggle__track" aria-hidden="true"></span>
        <span class="recurrence-toggle__copy">
          <strong>Repeats</strong>
          <small>Turn this on to make this event part of a recurring schedule.</small>
        </span>
      </label>
      <div data-event-recurrence-target="details">
        <div class="backoffice-form__check">
          <%= radio_button_tag 'recurrence[mode]', 'new', @recurrence[:mode] == 'new', id: 'recurrence_mode_new', data: { action: 'event-recurrence#update' } %>
          <%= label_tag 'recurrence_mode_new', 'Create a new recurring series' %>
        </div>
        <div class="backoffice-form__check">
          <%= radio_button_tag 'recurrence[mode]', 'existing', @recurrence[:mode] == 'existing', id: 'recurrence_mode_existing', data: { action: 'event-recurrence#update' } %>
          <%= label_tag 'recurrence_mode_existing', 'Add to an existing recurring series' %>
        </div>
        <div data-event-recurrence-target="newSeries">
          <div class="backoffice-form__field">
            <%= label_tag 'recurrence_frequency', 'Repeats' %>
            <%= select_tag 'recurrence[frequency]', options_for_select([['Every day', 'FREQ=DAILY'], ['Every week', 'FREQ=WEEKLY'], ['Every month', 'FREQ=MONTHLY'], ['Every year', 'FREQ=YEARLY'], ['Custom…', 'custom']], @recurrence[:frequency]), id: 'recurrence_frequency', data: { event_recurrence_target: 'frequency', action: 'event-recurrence#updateFrequency' } %>
          </div>
          <div class="backoffice-form__field" data-event-recurrence-target="customRule">
            <%= label_tag 'recurrence_custom_rule', 'Custom repeat rule' %>
            <%= text_field_tag 'recurrence[custom_rule]', @recurrence[:custom_rule], id: 'recurrence_custom_rule', placeholder: 'FREQ=WEEKLY;BYDAY=FR', autocomplete: 'off' %>
          </div>
          <div class="backoffice-form__field">
            <%= label_tag 'recurrence_ends_at', 'Ends (optional)' %>
            <%= datetime_local_field_tag 'recurrence[ends_at]', datetime_local_value(@recurrence[:ends_at]), id: 'recurrence_ends_at' %>
          </div>
        </div>
        <div class="backoffice-form__field" data-event-recurrence-target="existingSeries">
          <%= form.label :event_series_id, 'Recurring series' %>
          <%= form.collection_select :event_series_id, @event_series, :id, :name, { include_blank: 'Choose a recurring series' } %>
        </div>
      </div>
    </fieldset>
  <% elsif @event.event_series %>
    <p class="backoffice-form__note">This event belongs to the <strong><%= @event.event_series.name %></strong> recurring series.</p>
  <% end %>
  <div class="backoffice-form__check">
    <%= form.check_box :fair_queue_enabled %>
    <%= form.label :fair_queue_enabled, "Use Fair Queue for this event" %>
    <small>Favor performers with fewer completed turns before repeat turns.</small>
  </div>
  <div class="backoffice-form__check">
    <%= form.check_box :allow_queue_overrun %>
    <%= form.label :allow_queue_overrun, "Allow queue beyond event end" %>
    <small>Keep accepting songs after the planned end. This change is audited.</small>
  </div>
  <div class="backoffice-form__actions"><%= form.submit %></div>
<% end %>
