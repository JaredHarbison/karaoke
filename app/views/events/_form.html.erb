<%= form_with model: @event, url: form_url, method: form_method, local: true do |form| %>
  <% if @event.errors.any? %>
    <div role="alert">
      <h2><%= pluralize(@event.errors.count, "error") %> prevented saving:</h2>
      <ul>
        <% @event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, "Event name" %>
    <%= form.text_field :name, required: true %>
  </div>
  <div>
    <%= form.label :starts_at, "Starts" %>
    <%= form.datetime_local_field :starts_at, required: true %>
  </div>
  <div>
    <%= form.label :ends_at, "Ends" %>
    <%= form.datetime_local_field :ends_at %>
  </div>
  <div>
    <%= form.label :event_series_id, "Recurring series" %>
    <%= form.collection_select :event_series_id, @event_series, :id, :name, { include_blank: "One-off event" } %>
  </div>
  <div>
    <%= form.label :status, "Status" %>
    <%= form.select :status, Event.statuses.keys.map { |status| [status.humanize, status] } %>
  </div>
  <%= form.submit %>
<% end %>
