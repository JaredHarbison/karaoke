<main class="management-page" aria-labelledby="new-event-heading">
  <%= render 'shared/management_page_header', heading_id: 'new-event-heading', title: 'Create Event', back_label: 'Back to Events', back_path: venue_events_path(Current.venue.slug) %>
  <section class="management-card management-form-card">
    <%= render "form", form_url: venue_events_path(Current.venue.slug), form_method: :post %>
  </section>
</main>
