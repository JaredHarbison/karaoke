<div class="songs-page songs-page--manager">
  <main class="songs-main" aria-labelledby="events-heading">
    <div class="event-operations__section-heading">
      <div><h2 id="events-heading">Events</h2><p>Review upcoming karaoke nights for <%= Current.venue.name %>.</p></div>
      <% if Current.venue.is_admin?(current_user) %><%= link_to 'Create Event', new_venue_event_path(Current.venue.slug), class: 'song-action song-action--play' %><% end %>
    </div>
    <section class="event-operations__card" aria-label="Venue Events">
      <% if @events.any? %>
        <ul class="event-operations__list">
          <% @events.each do |event| %>
            <li class="event-operations__list-row">
              <div><strong><%= link_to event.name, venue_event_path(Current.venue.slug, event) %></strong><span><%= l(event.starts_at, format: :long) %> · <%= event.status.humanize %><%= " · #{event.event_series.name}" if event.event_series %></span></div>
              <% if Current.venue.is_admin?(current_user) %><%= link_to 'Edit Event', edit_venue_event_path(Current.venue.slug, event), class: 'song-action song-action--edit' %><% end %>
            </li>
          <% end %>
        </ul>
      <% else %><p class="event-operations__empty">No events have been scheduled yet.</p><% end %>
    </section>
  </main>
</div>
