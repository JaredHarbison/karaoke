%header.app-shell__header
  .app-shell__bar
    = render 'shared/brand_lockup'
    - if Current.venue.present?
      = link_to Current.venue.name, venue_events_path(Current.venue.slug), class: 'app-shell__venue'
    - if controller_path == 'songs' && action_name == 'presentation'
      = render 'songs/presentation_queue_menu'
    - event_host = @current_event&.host_authorized?(current_user)
    - menu_label = if Current.venue&.owner?(current_user)
      - 'Owner Menu'
    - elsif Current.venue&.admin?(current_user) || event_host
      - 'Host Menu'
    - else
      - 'Performer Menu'
    %details.app-menu{ data: { controller: 'disclosure', action: 'toggle->disclosure#toggle click@window->disclosure#closeOnOutside keydown@window->disclosure#closeOnEscape' } }
      %summary.app-menu__summary= menu_label
      .app-menu__drawer
        %button.app-menu__close{ type: 'button', aria: { label: 'Close menu' }, data: { action: 'disclosure#close' } } ×
        %nav.app-menu__nav{ aria: { label: menu_label } }
          = link_to 'Events', (Current.venue ? venue_events_path(Current.venue.slug) : root_path), class: 'app-menu__link'
          - if Current.venue && event_host && @current_event
            = link_to 'Presentation Mode', venue_event_presentation_path(Current.venue.slug, event_slug: @current_event.slug), class: 'app-menu__link', target: '_blank', rel: 'noopener noreferrer'
          - if Current.venue&.owner?(current_user)
            = link_to 'Venue Settings', venue_settings_path(Current.venue.slug), class: 'app-menu__link'
          = link_to 'Help', help_path, class: 'app-menu__link'
          - if user_signed_in?
            = link_to 'Account', edit_user_registration_path, class: 'app-menu__link'
            = button_to 'Sign Out', destroy_user_session_path, method: :delete, class: 'app-menu__sign-out'
          - else
            = link_to 'Sign In', new_user_session_path, class: 'app-menu__link'
  .app-shell__flash
    .app-flash{ aria: { live: 'polite' } }
      - if notice.present?
        %p.app-flash__message.app-flash__message--notice{ role: 'status', data: { controller: 'flash' } }= notice
      - if alert.present?
        %p.app-flash__message.app-flash__message--alert{ role: 'alert', data: { controller: 'flash' } }= alert
