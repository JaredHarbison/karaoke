.songs-page.songs-page--manager
  %main.songs-main{ aria: { labelledby: "help-heading" } }
    .event-operations__section-heading
      %div
        %h2#help-heading Help
        %p Guides are organized by the workflows available to your role.
    - @guides.each do |guide|
      %article.event-operations__card
        %h3= guide[:title]
        %p.event-operations__empty= guide[:summary]
        - if guide[:status] == :planned
          %p.event-operations__review-summary Planned / Forthcoming
        .event-operations__guide= render_help_markdown(guide[:body])
    - if @guides.empty?
      %p.event-operations__empty No help guides are available for your role yet.
