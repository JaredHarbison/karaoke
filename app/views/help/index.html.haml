.help
  %header.help__header
    %p.help__eyebrow Karaoke Queue help
    %h1 Help
    %p Guides are organized by the workflows available to your role.

  %main.help__guides
    - @guides.each do |guide|
      %article.help__guide
        %h2= guide[:title]
        %p.help__summary= guide[:summary]
        - if guide[:status] == :planned
          .help__status Planned / forthcoming
        .help__content= render_help_markdown(guide[:body])
    - if @guides.empty?
      %p No help guides are available for your role yet.
