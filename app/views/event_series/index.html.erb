<main class="management-page" aria-labelledby="event-series-heading">
  <%= render 'shared/management_page_header',
             heading_id: 'event-series-heading',
             title: 'Recurring Series',
             description: 'Series define recurring intent. Individual occurrences can be edited independently.',
             back_label: 'Back to Events', back_path: venue_events_path(Current.venue.slug),
             actions: [{ label: 'Create Recurring Series', path: new_venue_event_series_path(Current.venue.slug), style: :primary }] %>
  <section class="management-card" aria-label="Recurring event series">
  <% if @event_series.any? %>
    <ul class="management-list">
      <% @event_series.each do |series| %>
        <li class="management-list__item">
          <div class="management-list__identity">
            <%= link_to series.name, edit_venue_event_series_path(Current.venue.slug, series) %>
            <span><%= series.recurrence_rule %></span>
          </div>
          <div class="management-action-group">
            <%= button_to "Generate Next 8 Weeks", generate_occurrences_venue_event_series_path(Current.venue.slug, series), method: :post, class: 'management-button management-button--secondary' %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="management-empty">No recurring series have been created yet.</p>
  <% end %>
  </section>
</main>
