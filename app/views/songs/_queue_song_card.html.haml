- can_manage_song = song.user == current_user || can_manage_queue

%article.song-queue-card{ class: (next_song ? "song-queue-card--next" : "") }
  .song-queue-card__position
    - if next_song
      %span.song-next-badge Next
    - elsif position
      %span.song-position= "##{position}"
  .song-queue-card__details
    .song-queue-card__title-row
      %h3= song.performer
      - if song.category.present?
        %span.song-category= song.category
    %p.song-queue-card__meta
      - if can_manage_queue
        = song.title.presence || song.performer
      - elsif song.user == current_user
        Added by you
      - else
        Added by #{song.user&.email || "a performer"}
  .song-queue-card__actions
    - if can_manage_queue && song.finished
      = button_to requeue_song_venue_song_path(Current.venue.slug, song), method: :patch, class: "song-action song-action--requeue", title: "Return song to queue", form: { data: { turbo: false } } do
        %span.song-action__icon ↩
        %span Requeue
      = button_to venue_song_path(Current.venue.slug, song), method: :delete, class: "song-action song-action--remove", title: "Remove archived performance", data: { turbo_confirm: "Permanently remove #{song.performer}'s archived performance?" } do
        %span.song-action__icon ×
        %span Remove
    - if can_manage_queue && !song.finished
      - if next_song
        %button.song-action.song-action--play{ type: "button", title: "Play next song fullscreen", data: { action: "youtube-player#play", youtube_player_url_param: song.url, youtube_player_finish_url_param: finish_song_venue_song_path(Current.venue.slug, song), youtube_player_performer_param: song.performer } }
          %span.song-action__icon ▶
          %span Play
      = link_to song.url, class: "song-action song-action--open", title: "Open video in a new tab", target: "_blank", rel: "noopener noreferrer" do
        %span.song-action__icon ↗
        %span Open
      = button_to finish_song_venue_song_path(Current.venue.slug, song), method: :patch, class: "song-action song-action--finish", title: "Finish song", form: { data: { turbo: false } } do
        %span.song-action__icon ✓
        %span Finish
      = button_to skip_song_venue_song_path(Current.venue.slug, song), method: :patch, class: "song-action song-action--skip", title: (song.skipped? ? "Return song" : "Skip song"), form: { data: { turbo: false } } do
        %span.song-action__icon= song.skipped? ? "↩" : "Ⅱ"
        %span= song.skipped? ? "Return" : "Skip"
    - if can_manage_song && !song.finished
      %details.song-actions-secondary{ data: { controller: "disclosure", action: "click@window->disclosure#closeOnOutside keydown@window->disclosure#closeOnEscape" } }
        %summary.song-action.song-action--more
          %span.song-action__icon ⋯
          %span More
        .song-actions-menu
          = link_to edit_venue_song_path(Current.venue.slug, song), class: "song-action song-action--edit", title: "Edit song" do
            %span.song-action__icon ✎
            %span Edit
          = button_to venue_song_path(Current.venue.slug, song), method: :delete, class: "song-action song-action--remove", title: "Remove song", data: { turbo_confirm: "Remove #{song.performer}'s song from the queue?" } do
            %span.song-action__icon ×
            %span Remove
