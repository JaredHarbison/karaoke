- can_manage_queue = @can_manage_queue
- performer_view = !can_manage_queue
- next_performer = @upcoming.first&.performer
- active_tab = performer_view ? "add" : (@song.errors.any? ? "add" : "queue")

.songs-page{ class: [("songs-page--manager" if can_manage_queue), ("songs-page--performer" if performer_view)], data: ({ controller: [can_manage_queue ? "youtube-player" : nil, (@queue_state_url ? "queue-refresh" : nil)].compact.join(" "), queue_refresh_url_value: @queue_state_url, queue_refresh_version_value: @queue_version } if can_manage_queue || @queue_state_url) }
  %main.songs-main
    - if @current_event
      - unless @current_event.live?
        %p.songs-queue-explanation{ role: "status" }= @current_event.scheduled? ? "This event has not started. Queueing opens when the host starts it." : "This event is closed to new queue submissions."
    .songs-responsive-tabs{ data: { controller: "responsive-tabs", responsive_tabs_breakpoint_value: 1000 } }
      .songs-tabs{ role: "tablist", aria: { label: "Venue queue sections" } }
        %button.songs-tab{ id: "queue-tab", type: "button", role: "tab", tabindex: (active_tab == "queue" ? "0" : "-1"), aria: { controls: "queue-panel", selected: (active_tab == "queue").to_s }, data: { responsive_tabs_target: "tab", tab_name: "queue", action: "click->responsive-tabs#select keydown->responsive-tabs#navigate" } } Queue
        %button.songs-tab{ id: "add-tab", type: "button", role: "tab", tabindex: (active_tab == "add" ? "0" : "-1"), aria: { controls: "add-panel", selected: (active_tab == "add").to_s }, data: { responsive_tabs_target: "tab", tab_name: "add", action: "click->responsive-tabs#select keydown->responsive-tabs#navigate" } } Add Song
        - if can_manage_queue && @current_event
          %button.songs-tab{ id: "themes-tab", type: "button", role: "tab", tabindex: "-1", aria: { controls: "themes-panel", selected: "false" }, data: { responsive_tabs_target: "tab", tab_name: "themes", action: "click->responsive-tabs#select keydown->responsive-tabs#navigate" } }
            Themes
            - if @theme_review.any?
              %span.songs-tab__badge{ aria: { label: "#{pluralize(@theme_review.count, 'performance')} needs theme review" } }= @theme_review.count
          - if Current.venue.is_admin?(current_user)
            %button.songs-tab{ id: "hosts-tab", type: "button", role: "tab", tabindex: "-1", aria: { controls: "hosts-panel", selected: "false" }, data: { responsive_tabs_target: "tab", tab_name: "hosts", action: "click->responsive-tabs#select keydown->responsive-tabs#navigate" } } Temporary Hosts
          %button.songs-tab{ id: "event-tab", type: "button", role: "tab", tabindex: "-1", aria: { controls: "event-panel", selected: "false" }, data: { responsive_tabs_target: "tab", tab_name: "event", action: "click->responsive-tabs#select keydown->responsive-tabs#navigate" } } Event

      - if can_manage_queue
        .songs-tab-panels
          .songs-tab-panel.songs-tab-panel--queue{ id: "queue-panel", role: "tabpanel", aria: { labelledby: "queue-tab" }, data: { responsive_tabs_target: "panel", tab_name: "queue" } }
            %section.songs-panel.songs-panel--queue{ aria: { labelledby: "upcoming-heading" } }
              .songs-panel__heading
                .songs-panel__queue-title
                  %h2#upcoming-heading
                    %span Upcoming
                    %span.songs-heading__mobile-hide Performers
                  %span.songs-count
                    %span In Line
                    %span= @upcoming_total

              = render "upcoming_list", upcoming: @upcoming, upcoming_page: @upcoming_page, upcoming_has_more: @upcoming_has_more, performing_song: @performing_song
              = render "post_theme_list", post_theme: @post_theme, can_manage_queue: can_manage_queue

              - if @theme_review.any?
                %section.songs-panel.songs-panel--theme-review{ aria: { labelledby: "theme-review-heading" } }
                  %h2#theme-review-heading Theme review
                  %p.songs-muted These songs need a host decision before they enter the playable queue.
                  %ul
                    - @theme_review.each do |song|
                      - content_policy_review = song.theme_admission_reason.to_s.start_with?("content policy:")
                      %li
                        %strong= song.performer
                        %span= song.title.presence || song.url
                        %small= song.theme_admission_reason
                        - if content_policy_review
                          = button_to "Reject for Content Policy", review_theme_venue_song_path(Current.venue.slug, song), method: :patch, params: { decision: "reject", rejection_reason: "content_policy" }
                        - else
                          = button_to "Approve Theme Fit", review_theme_venue_song_path(Current.venue.slug, song), method: :patch, params: { decision: "approve" }
                          = button_to "Reject Theme Fit", review_theme_venue_song_path(Current.venue.slug, song), method: :patch, params: { decision: "reject", rejection_reason: "theme" }

              - if @skipped.any?
                .songs-subsection
                  .songs-subsection__heading
                    %h3 On Hold
                    %span.songs-count.songs-count--muted= @skipped.count
                  .song-card-list
                    - @skipped.each do |song|
                      = render "queue_song_card", song: song, position: nil, next_song: false, can_manage_queue: can_manage_queue
            = render "finished_panel"
          .songs-tab-panel.songs-tab-panel--add{ id: "add-panel", role: "tabpanel", aria: { labelledby: "add-tab" }, data: { responsive_tabs_target: "panel", tab_name: "add" } }
            = render "add_song_panel", song: @song
          - if @current_event
            = render "manager_event_panels"
      - else
        .songs-tab-panels.songs-tab-panels--performer
          .songs-tab-panel.songs-tab-panel--add{ id: "add-panel", role: "tabpanel", aria: { labelledby: "add-tab" }, data: { responsive_tabs_target: "panel", tab_name: "add" } }
            = render "add_song_panel", song: @song
          .songs-tab-panel.songs-tab-panel--queue{ id: "queue-panel", role: "tabpanel", aria: { labelledby: "queue-tab" }, data: { responsive_tabs_target: "panel", tab_name: "queue" } }
            %section.songs-panel.songs-panel--queue{ aria: { labelledby: "upcoming-heading" } }
              .songs-panel__heading
                .songs-panel__queue-title
                  %h2#upcoming-heading
                    %span Upcoming
                    %span.songs-heading__mobile-hide Performers
                  %span.songs-count
                    %span In Line
                    %span= @upcoming_total

              = render "upcoming_list", upcoming: @upcoming, upcoming_page: @upcoming_page, upcoming_has_more: @upcoming_has_more, performing_song: @performing_song
              = render "post_theme_list", post_theme: @post_theme, can_manage_queue: can_manage_queue

              - if @skipped.any?
                .songs-subsection
                  .songs-subsection__heading
                    %h3 On Hold
                    %span.songs-count.songs-count--muted= @skipped.count
                  .song-card-list
                    - @skipped.each do |song|
                      = render "queue_song_card", song: song, position: nil, next_song: false, can_manage_queue: can_manage_queue
            = render "finished_panel"

  - if can_manage_queue
    .song-player{ hidden: true, role: "dialog", aria: { modal: "true", label: "Now playing" }, data: { youtube_player_target: "overlay", action: "fullscreenchange@document->youtube-player#fullscreenChanged" } }
      .song-player__toolbar
        %div
          %h2{ data: { youtube_player_target: "title" } }
        .song-player__toolbar-actions
          %button.song-player__close{ type: "button", data: { action: "youtube-player#endAndAdvance", youtube_player_target: "closeButton" } }
            %span{ aria: { hidden: "true" } } ×
            %span End & Advance
      .song-player__viewport
        %div.song-player__mount{ data: { youtube_player_target: "mount" } }
      %p.song-player__status{ role: "status", aria: { live: "polite" }, data: { youtube_player_target: "status" } }
