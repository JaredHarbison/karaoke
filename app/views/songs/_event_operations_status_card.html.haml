%section.event-operations__card
  %h3 Status
  %dl.event-operations__status-list
    %div
      %dt State
      %dd= current_event.status.humanize
    %div
      %dt Queue
      %dd #{pluralize(upcoming_total, "playable performance")} · #{pluralize(theme_review.count, "awaiting theme review")}
    %div
      %dt Projected queue end
      %dd= l(queue_projected_completion_at, format: :short)
    - if current_event.ends_at
      %div
        %dt Scheduled end
        %dd= l(current_event.ends_at, format: :short)
    %div
      %dt Queue policy
      %dd= current_event.allow_queue_overrun? ? "Overrun allowed" : "Stops at scheduled end"
  - if current_event.scheduled? && can_configure_event
    .event-operations__status-action
      = button_to "Start Event", start_venue_event_path(Current.venue.slug, current_event), method: :patch, class: "song-action song-action--play"
  - elsif current_event.live?
    .event-operations__status-action
      = button_to "Complete Event", complete_venue_event_path(Current.venue.slug, current_event), method: :patch, class: "song-action song-action--remove"
