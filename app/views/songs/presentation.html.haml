.songs-page.songs-page--presentation{ data: { controller: "youtube-player queue-refresh", queue_refresh_url_value: @queue_state_url, queue_refresh_version_value: @queue_version } }
  %main.songs-presentation
    %section.songs-presentation__stage
      .songs-presentation__screen
        - if @presentation_next_song
          .songs-presentation__screen-content
            %span.songs-presentation__screen-eyebrow UP NEXT
            %h1= @presentation_next_song.performer
            %div.songs-presentation__screen-actions
              %button.song-action.song-action--play{ type: "button", title: "Play next song", data: { action: "youtube-player#play", youtube_player_url_param: @presentation_next_song.url, youtube_player_start_url_param: start_song_venue_song_path(Current.venue.slug, @presentation_next_song), youtube_player_finish_url_param: finish_song_venue_song_path(Current.venue.slug, @presentation_next_song), youtube_player_stop_url_param: stop_song_venue_song_path(Current.venue.slug, @presentation_next_song), youtube_player_performer_param: @presentation_next_song.performer, youtube_player_up_next_performer_param: @presentation_second_song&.performer, youtube_player_up_next_title_param: (@presentation_second_song && display_song_title(@presentation_second_song)), youtube_player_up_second_performer_param: @presentation_third_song&.performer, youtube_player_up_second_title_param: (@presentation_third_song && display_song_title(@presentation_third_song)) } }
                %span.song-action__icon ▶
                %span Play Next Song
        - else
          .songs-presentation__screen-content
            %span.songs-presentation__screen-eyebrow Ready
            %h1 Ready for the First Song
            %p.songs-presentation__screen-copy Use the performer view to add a song, then return here to launch it on the presentation stage.

      .song-player{ hidden: true, role: "dialog", aria: { modal: "true", label: "Now playing" }, data: { youtube_player_target: "overlay", action: "fullscreenchange@document->youtube-player#fullscreenChanged" } }
        .song-player__toolbar
          %div
            %h2{ data: { youtube_player_target: "title" } }
          .song-player__toolbar-actions
            %button.song-player__close{ type: "button", data: { action: "youtube-player#endAndAdvance", youtube_player_target: "closeButton" } }
              %span{ aria: { hidden: "true" } } ×
              %span End & Advance
            %button.song-player__close.song-player__close--secondary{ type: "button", data: { action: "youtube-player#close" } }
              %span End Without Progressing
        .song-player__viewport
          %div.song-player__mount{ data: { youtube_player_target: "mount" } }
        %p.song-player__status{ role: "status", aria: { live: "polite" }, data: { youtube_player_target: "status" } }

    %footer.songs-presentation__footer
      %div.songs-presentation__footer-item.songs-presentation__footer-item--code
        %span.songs-presentation__footer-label Event Access Code
        %strong{ aria: { label: "Event Access Code" } }= @presentation_event_code.presence || "—"
      %div.songs-presentation__footer-item
        %span.songs-presentation__footer-label{ data: { youtube_player_target: "presentationNextLabel" } } Up Next
        %strong{ data: { youtube_player_target: "presentationNextPerformer" } }= @presentation_next_song&.performer || "Nothing queued"
        %span{ data: { youtube_player_target: "presentationNextTitle" } }= @presentation_next_song ? display_song_title(@presentation_next_song) : "Add a song to begin"
      %div.songs-presentation__footer-item
        %span.songs-presentation__footer-label Up Second
        %strong{ data: { youtube_player_target: "presentationSecondPerformer" } }= @presentation_second_song&.performer || "—"
        %span{ data: { youtube_player_target: "presentationSecondTitle" } }= @presentation_second_song ? display_song_title(@presentation_second_song) : ""
