= form_for( song, url: venue_song_path(Current.venue.slug, song) ) do |s|
  %tr
    %td= link_to song.performer, venue_song_path(Current.venue.slug, song)
    - if upcoming
      %td
        = render "button_action_song", action: "finish", song: @upcoming[ 0 ]
    - else
      %td
    - [ "skip", "edit", "destroy" ].each do | action | 
      %td 
        = render "button_action_song", action: action, song: song
