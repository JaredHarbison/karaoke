- venue_slug = @current_venue&.slug || Current.venue&.slug || params[:venue_slug]
- song_form_url = @current_event ? venue_event_queue_path(venue_slug, event_slug: @current_event.slug) : venue_songs_path(venue_slug)
= form_with(model: song, scope: :song, local: true, url: song_form_url, data: { turbo: false, controller: "youtube-search", youtube_search_venue_slug: venue_slug, action: "submit->youtube-search#submit" }) do |form|
  = form.hidden_field :submission_token
  = form.hidden_field :url, id: "song_url"
  = form.hidden_field :title, id: "song_title"
  - if song.errors.any?
    #error_explanation
      %h2
        = pluralize(song.errors.count, "error")
        prohibited this song from being saved:
      %ul
        - song.errors.full_messages.each do |message|
          %li= message
  
  .youtube-search-container
    .search-header
      %h3 Add a Karaoke Song
    
    .search-input-group
      %label{ for: "song-search" } Search for a Song:
      .input-row
        %div#song-query-wrapper
          %input#song-search{ type: "text", data: { youtube_search_target: "query" }, placeholder: "Enter song name or artist", autocomplete: "off" }
        %button.search-btn{ type: "button", data: { action: "click->youtube-search#search", youtube_search_target: "searchBtn" } } Search
    
    .youtube-results-rail
      %button.youtube-results__control.youtube-results__control--previous{ type: "button", hidden: true, aria: { label: "Show previous YouTube results", controls: "song-results" }, data: { youtube_search_target: "previousButton", action: "click->youtube-search#previousResults" } }
        %span{ aria: { hidden: "true" } } ←
      %div#song-results.youtube-results-container{ role: "region", aria: { label: "YouTube search results" }, data: { youtube_search_target: "results" } }
      %button.youtube-results__control.youtube-results__control--next{ type: "button", hidden: true, aria: { label: "Show more YouTube results", controls: "song-results" }, data: { youtube_search_target: "nextButton", action: "click->youtube-search#nextResults" } }
        %span{ aria: { hidden: "true" } } →
    
  - unless index_page
    .form-actions
      = form.submit "Queue Song", class: "btn btn--primary", data: { disable_with: "Queueing..." }
