- venue_slug = @current_venue&.slug || Current.venue&.slug || params[:venue_slug]
= form_with(model: song, local: true, url: venue_songs_path(venue_slug), data: { turbo: false }) do |form|
  - if song.errors.any?
    #error_explanation
      %h2
        = pluralize(song.errors.count, "error")
        prohibited this song from being saved:
      %ul
        - song.errors.full_messages.each do |message|
          %li= message
  
  .youtube-search-container{ data: { controller: "youtube-search", youtube_search_venue_slug: venue_slug } }
    .search-header
      %h3 Add a Karaoke Song
    
    .search-input-group
      %label{ for: "song-search" } Search for a song:
      .input-row
        %div#song-query-wrapper
          %input#song-search{ type: "text", data: { youtube_search_target: "query" }, placeholder: "Enter song name or artist", autocomplete: "off" }
        %button.search-btn{ type: "button", data: { action: "click->youtube-search#search", youtube_search_target: "searchBtn" } } Search
    
    %div#song-results{ data: { youtube_search_target: "results" }, class: "youtube-results-container" }
    
    .video-selection
      = label_tag do
        %strong 📎 Selected Video URL:
        %div#song-url-wrapper
          \#{form.text_field :url, data: { youtube_search_target: "urlField" }, placeholder: "URL will appear here or paste manually", readonly: true}
      = form.hidden_field :title, data: { youtube_search_target: "titleField" }
  
  .form-actions
    = form.submit "Queue Song", class: "btn btn-primary btn-large", data: { disable_with: "Queueing..." }
