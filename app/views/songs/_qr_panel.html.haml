%details.songs-panel.songs-panel--qr{ open: true }
  %summary.songs-panel__summary
    %h2#qr-heading Scan to Join
    %span.songs-panel__summary-action
      %span.songs-panel__summary-label= "Show"
    %span.songs-panel__summary-copy Scan this code from your phone to open this venue’s queue.
  .songs-panel__collapsible
    .songs-qr
      = image_tag "Untitled.png", alt: "QR code for the #{Current.venue.name} queue"
    %code.songs-qr__url= queue_url
