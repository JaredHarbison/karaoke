- if action == "finish"
  = link_to song.url, class: "btn discreet", title: action, target: "_blank", data: { controller: "song-action", song_action_action_value: action, song_action_id_value: song.id, action: "click->song-action#perform" } do
    %span 
      = render "components/icons/play"
- elsif action == "skip"
  %button{ class: "btn discreet", title: song.skipped ? "resume" : "skip", data: { controller: "song-action", song_action_action_value: action, song_action_id_value: song.id, action: "click->song-action#perform" } }
    - if song.skipped 
      %span 
        = render "components/icons/add"
    - else 
      %span 
        = render "components/icons/skip"
- elsif action == "edit"
  = link_to edit_song_path(song), class: "btn discreet", title: action do
    %span
      = render "components/icons/edit"
- else 
  = button_to song, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn discreet", title: action do
    %span 
      = render "components/icons/destroy"