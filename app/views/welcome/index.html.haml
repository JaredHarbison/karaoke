.welcome-page{ data: { controller: "cta-size time-of-day" } }
  %header.welcome-header
    .welcome-header__copy
      %h1 Where Are You Singing <span data-time-of-day-target="label">Tonight</span>?
      %p Browse public karaoke venues, join a queue, and come back to your last spot whenever you need to.
    - if @last_venue
      - resume_host = @last_venue.hosts.first || @last_venue.owner
      - resume_queue_count = @queue_counts[@last_venue.id] || 0
      %article.venue-card.resume-card
        %span.resume-card__label Continue where you left off
        %h3= @last_venue.name
        %p.venue-card__location= @last_venue.location.presence || "Location not listed"
        %p.venue-card__host= "#{resume_host&.display_name || "Venue team"} is hosting!"
        %p.venue-card__queue
          - if resume_queue_count.zero?
            No wait — jump in
          - else
            #{resume_queue_count} #{resume_queue_count == 1 ? 'song' : 'songs'} in queue · about #{resume_queue_count * 5} min wait
        - last_event = @venue_events[@last_venue.id]
        - resume_status = last_event&.accepting_signups? ? "open for signups" : (last_event ? "upcoming" : "not accepting signups")
        - resume_status_active = last_event&.accepting_signups?
        .venue-card__footer
          .venue-card__status{ class: ("venue-card__status--neutral" unless resume_status_active) }
            %span.venue-card__status-dot{ aria: { hidden: "true" } }
            %span= resume_status
          = link_to (last_event&.accepting_signups? ? "Go to queue" : "Go to event"), event_entry_path(@last_venue, last_event), class: "welcome-button welcome-button--primary", data: { cta_size_target: "button" }

  %main.welcome-main
    .welcome-toolbar
      = form_with url: root_path, method: :get, local: true, class: "venue-search" do |form|
        = form.search_field :search, value: params[:search], placeholder: "search venues or locations", aria: { label: "Search public venues" }
        %button.welcome-button.welcome-button--primary.venue-search__submit{ type: "submit", aria: { label: "Search venues" }, data: { cta_size_target: "button" } }
          %svg.search-icon{ viewBox: "0 0 24 24", aria: { hidden: "true" } }
            %circle{ cx: "11", cy: "11", r: "6.5" }
            %path{ d: "m16 16 5 5" }

    - if @venues.any?
      .venue-card-grid
        - @venues.each do |venue|
          - featured_host = venue.hosts.first || venue.owner
          %article.venue-card
            %h3= venue.name
            %p.venue-card__location= venue.location.presence || "Location not listed"
            %p.venue-card__host= "#{featured_host&.display_name || "Venue team"} is hosting!"
            - queue_count = @queue_counts[venue.id] || 0
            %p.venue-card__queue
              - if queue_count.zero?
                No wait — jump in
              - else
                #{queue_count} #{queue_count == 1 ? 'song' : 'songs'} in queue · about #{queue_count * 5} min wait
            .venue-card__footer
              - event = @venue_events[venue.id]
              - event_status = event&.accepting_signups? ? "open for signups" : (event ? "upcoming" : "not accepting signups")
              - event_status_active = event&.accepting_signups?
              .venue-card__status{ class: ("venue-card__status--neutral" unless event_status_active) }
                %span.venue-card__status-dot{ aria: { hidden: "true" } }
                %span= event_status
              = link_to (event&.accepting_signups? ? "View queue" : "View event"), event_entry_path(venue, event), class: "welcome-button welcome-button--primary", data: { cta_size_target: "button" }
    - else
      .venue-empty
        %span.venue-empty__icon 🎤
        %h3 No public venues found
        %p Try a different search, or ask the venue owner for a direct link.
        = link_to "Clear search", root_path, class: "welcome-button welcome-button--secondary" if params[:search].present?

  %footer.welcome-footer
    %span More venue discovery options are coming soon.
    = button_to "Sign out", destroy_user_session_path, method: :delete, class: "welcome-footer__signout"
