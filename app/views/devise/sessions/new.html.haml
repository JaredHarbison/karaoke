%main.auth-page{ aria: { labelledby: 'sign-in-heading' } }
  .auth-card
    %h1#sign-in-heading Sign In to Continue

    = render 'devise/shared/google_button', autofocus: true

    .auth-divider
      %span or

    = form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-form' }) do |f|
      = text_field_tag :website, nil, class: 'auth-honeypot', autocomplete: 'off', tabindex: -1, aria: { hidden: true }
      .field
        = f.label :email, 'Email Address'
        = f.email_field :email, autocomplete: 'email'
      .field
        = f.label :password, 'Password'
        = f.password_field :password, autocomplete: 'current-password'
        = link_to 'Forgot Password?', new_password_path(resource_name), class: 'auth-inline-link'
      - if devise_mapping.rememberable?
        .checkbox-field
          = f.check_box :remember_me
          = f.label :remember_me, 'Remember Me'
      .actions
        = f.submit 'Sign In', class: 'auth-submit'

    .auth-footer
      %span New here?
      = link_to 'Create an Account', new_user_registration_path(auth_link_options), class: 'auth-link'
